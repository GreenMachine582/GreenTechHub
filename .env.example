###############################################
# GreenTechHub Environment Configuration
#
# Copy this file to:
#   .env        → non-sensitive config
#   .env.secret → secrets (DO NOT COMMIT)
###############################################

# ==================================================
# Non-sensitive configuration (safe to commit)
# ==================================================

# ---- Django runtime ----
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional environment label
# e.g. development | staging | production
ENVIRONMENT=development

# ---- Database (PostgreSQL) ----
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=greentechhub
DATABASE_USER=greentechhub

# Convenience variables (used by Docker/Postgres)
POSTGRES_DB="${DATABASE_NAME}"
POSTGRES_USER="${DATABASE_USER}"

# ---- Site / domain ----
SITE_DOMAIN=green-tech-hub.com
SITE_NAME=GreenTechHub

# ---- Email (non-secret settings) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_TIMEOUT=30
EMAIL_PORT=587
EMAIL_USE_TLS=true

# ==================================================
# Sensitive configuration (DO NOT COMMIT)
# Copy these into .env.secret
# ==================================================

# ---- Django secret ----
SECRET_KEY=change-me

# ---- Database secret ----
DATABASE_PASSWORD=change-me
POSTGRES_PASSWORD="${DATABASE_PASSWORD}"

# ---- Social authentication ----
SOCIAL_AUTH_CLIENT_ID_GOOGLE=change-me
SOCIAL_AUTH_CLIENT_SECRET_GOOGLE=change-me

SOCIAL_AUTH_CLIENT_ID_GITHUB=change-me
SOCIAL_AUTH_CLIENT_SECRET_GITHUB=change-me

# ---- Email credentials ----
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=change-me@example.com

# ---- Initial superuser (optional automation) ----
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
